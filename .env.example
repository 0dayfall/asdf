# Server Configuration
WEBFINGER_SERVER_PORT=8080
WEBFINGER_SERVER_HOST=0.0.0.0
WEBFINGER_SERVER_CERT_PATH=/certs/server.crt
WEBFINGER_SERVER_KEY_PATH=/certs/server.key
WEBFINGER_SERVER_ENV=development

# Database Configuration
WEBFINGER_DATABASE_URL=postgres://webfinger:secret@localhost:5432/webfinger?sslmode=disable
WEBFINGER_DATABASE_MAX_OPEN_CONNS=25
WEBFINGER_DATABASE_MAX_IDLE_CONNS=5

# Redis Configuration
WEBFINGER_REDIS_URL=redis://localhost:6379
WEBFINGER_REDIS_PASSWORD=
WEBFINGER_REDIS_DB=0

# Authentication Configuration
WEBFINGER_AUTH_JWT_SECRET=your-very-secure-jwt-secret-key-here-change-this-in-production
WEBFINGER_AUTH_SESSION_SECRET=your-very-secure-session-secret-here-change-this-in-production
WEBFINGER_AUTH_TOKEN_EXPIRY_HOURS=24

# Security Configuration
WEBFINGER_SECURITY_RATE_LIMIT_RPS=10
WEBFINGER_SECURITY_RATE_LIMIT_BURST=20
WEBFINGER_SECURITY_ALLOWED_ORIGINS=*
WEBFINGER_SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
WEBFINGER_SECURITY_ENABLE_CSP=true
WEBFINGER_SECURITY_ENABLE_HSTS=true
WEBFINGER_SECURITY_FORCE_HTTPS=false

# Logging Configuration
WEBFINGER_LOGGING_LEVEL=info
WEBFINGER_LOGGING_FORMAT=json
WEBFINGER_LOGGING_OUTPUT=stdout

# Legacy environment variables for backward compatibility
PORT=8080
DATABASE_URL=postgres://webfinger:secret@localhost:5432/webfinger?sslmode=disable
SSL_CERT_PATH=/certs/server.crt
SSL_KEY_PATH=/certs/server.key
GO_ENV=development